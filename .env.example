# Example environment variables
# PORT (the host will usually provide this)
PORT=8000

# All keys below are optional and can also be entered at /settings (stored
# server-side). A setting saved there overrides the matching variable here.

# AI analyst report — any one provider is enough. When several are set they are
# tried in order: Anthropic -> OpenAI -> Gemini -> OpenRouter. Without any key the
# AI report section simply does not render.
ANTHROPIC_API_KEY=        # https://console.anthropic.com
OPENAI_API_KEY=           # https://platform.openai.com
GEMINI_API_KEY=           # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=       # https://openrouter.ai/keys

# Market-positioning data providers (the app ships with a shared Finnhub key;
# your own keys act as quota fallbacks). SEC EDGAR is keyless but wants a contact.
FINNHUB_API_KEY=          # https://finnhub.io
FMP_API_KEY=              # https://financialmodelingprep.com
SEC_USER_AGENT=           # "Your Name your@email.com"
